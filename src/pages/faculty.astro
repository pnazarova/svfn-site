---
import Layout from '../layouts/Layout.astro';
import Portrait from '../components/Portrait.astro';
import { guestsWithPhoto, guestsListed } from '../data/guests.js';
import { principals } from '../data/people.js';


---

<Layout title="Faculty">
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Faculty</p>
      <h1 class="display h2">The people teaching.</h1>
      <p class="lede" style="margin-top:22px;">
        Every program is convened with the people who defined its field. They teach it themselves.
      </p>
    </div>
  </section>

  <hr class="rule" />

  <section>
    <div class="shell">
      <div class="grid grid--2" data-rise-group>
        {principals.map((p) => (
          <article class="card fac">
            <Portrait src={p.photo} name={p.name} size="lg" />
            <div class="fac-txt">
              <p class="label">{p.role}</p>
              <h2 class="display h4">{p.name}</h2>
              <p>{p.bio ?? <span class="todo">bio, 60–80 words</span>}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section>
    <div class="shell">
      <p class="eyebrow">Guest practitioners</p>
      <h2 class="display h3" style="margin-bottom:10px;">They join the sessions in their field.</h2>
      <div class="guest-grid" data-rise-group>
        {guestsWithPhoto.map((g) => (
          <figure class="guest-card">
            <Portrait src={g.photo} name={g.name} size="md" />
            <figcaption>
              <span class="gname">{g.name}</span>
              <span class="gaff">{g.affiliation}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="guest-list" style="margin-top:40px;">
        {guestsListed.map((g) => (
          <div class="guest-row">
            <span class="gname">{g.name}</span>
            <span class="gaff">{g.affiliation}</span>
            <span class="gses">{g.session}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-top: clamp(48px, 7vw, 84px); }
  .fac { display: grid; grid-template-columns: auto 1fr; gap: 26px; align-items: start; }
  .fac h2 { margin: 6px 0 10px; }
  @media (max-width: 620px) { .fac { grid-template-columns: 1fr; gap: 18px; } }
  .ph--sm { width: 52px; height: 52px; border-radius: 50%; background: var(--bone);
    border: 1px solid var(--line); margin-bottom: 14px; }
  .guest h3 { font-size: 1rem; margin-bottom: 4px; }
  .guest p { font-size: .84rem; }
</style>
