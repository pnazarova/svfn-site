---
import Layout from '../layouts/Layout.astro';
import Portrait from '../components/Portrait.astro';
import { guestsWithPhoto, guestsListed } from '../data/guests.js';

// To add a photo: drop the file in public/faculty/ and set `photo` below.
const principals = [
  {
    name: 'Gregory La Blanc',
    role: 'Faculty Director',
    photo: '/faculty/gregory-la-blanc.jpg',
    bio: `Greg is Faculty Director of Professional Education at UC Berkeley's College of
      Engineering and a Distinguished Teaching Fellow at Berkeley Haas and Berkeley Law.
      He has taught at Stanford's Graduate School of Business and HEC Paris, and holds the
      Haas Cheit Award for teaching. He has advised leaders at more than a hundred companies
      and governments on strategy, finance and technology, and hosts unSILOed, a podcast now
      past six hundred conversations.`,
  },
  {
    name: 'Carlos Escapa',
    role: 'Program Lead · Chief AI Officer Program',
    photo: '/faculty/carlos-escapa.jpg',
    bio: `Carlos led AI and machine learning practice at AWS for nearly a decade, first as
      Global AI/ML Practice Leader and later running Data and AI for the Accenture-AWS
      Business Group, with a period at Meta in AI business development in between. He has
      worked on hundreds of implementation projects worldwide and coauthored The AI-Driven Business: Leading, Competing and Thriving in the Age of
      Artificial Intelligence. He advises startups on corporate development and
      go-to-market, and lectures at Berkeley Haas, ESADE and IE.`,
  },
];

---

<Layout title="Faculty">
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Faculty</p>
      <h1 class="display h2">The people teaching.</h1>
      <p class="lede" style="margin-top:22px;">
        Every program is convened with the people who defined its field. They teach it themselves.
      </p>
    </div>
  </section>

  <hr class="rule" />

  <section>
    <div class="shell">
      <div class="grid grid--2">
        {principals.map((p) => (
          <article class="card fac">
            <Portrait src={p.photo} name={p.name} size="lg" />
            <div class="fac-txt">
              <p class="label">{p.role}</p>
              <h2 class="display h4">{p.name}</h2>
              <p>{p.bio ?? <span class="todo">bio, 60–80 words</span>}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section>
    <div class="shell">
      <p class="eyebrow">Guest practitioners</p>
      <h2 class="display h3" style="margin-bottom:10px;">They join the sessions in their field.</h2>
      <div class="guest-grid">
        {guestsWithPhoto.map((g) => (
          <figure class="guest-card">
            <Portrait src={g.photo} name={g.name} size="md" />
            <figcaption>
              <span class="gname">{g.name}</span>
              <span class="gaff">{g.affiliation}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="guest-list" style="margin-top:40px;">
        {guestsListed.map((g) => (
          <div class="guest-row">
            <span class="gname">{g.name}</span>
            <span class="gaff">{g.affiliation}</span>
            <span class="gses">{g.session}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-top: clamp(48px, 7vw, 84px); }
  .fac { display: grid; grid-template-columns: auto 1fr; gap: 26px; align-items: start; }
  .fac h2 { margin: 6px 0 10px; }
  @media (max-width: 620px) { .fac { grid-template-columns: 1fr; gap: 18px; } }
  .ph--sm { width: 52px; height: 52px; border-radius: 50%; background: var(--bone);
    border: 1px solid var(--line); margin-bottom: 14px; }
  .guest h3 { font-size: 1rem; margin-bottom: 4px; }
  .guest p { font-size: .84rem; }
</style>
