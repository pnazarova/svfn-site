---
import Layout from '../../layouts/Layout.astro';
import Portrait from '../../components/Portrait.astro';

// The nine principles, titled exactly as the book titles them.
// Verified against two independent sources, May 2024 edition.
const sessions = [
  { n: 'Opening session', t: 'Bring the decision you are afraid to get wrong',
    d: 'Materials reach you two weeks before we start. You arrive with one decision actually on your table: the acquisition, the platform bet, the market you are about to enter or walk away from. That decision becomes the case for the next nine sessions.' },
  { n: 'Principle one', t: 'Home Runs Matter, Strikeouts Don\'t',
    d: 'One investment in fifty pays for the other forty-nine. Your budget process is built to prevent exactly that outcome, and this session puts a number on what it costs you to run five safe projects instead of twenty risky ones.' },
  { n: 'Principle two', t: 'Get Outside the Four Walls',
    d: 'Nobody walks the best opportunity into your office. The quality of every decision you make is capped by who you talk to outside the building, and most executive calendars are built to guarantee you never do.' },
  { n: 'Principle three', t: 'Prepare Your Mind',
    d: 'Investors who decide in a week did the work months earlier. Choosing the ground you intend to play on before anyone shows you a deck, so that when it lands you are recognizing rather than analyzing.' },
  { n: 'Principle four', t: 'Say No 100 Times',
    d: 'Ninety-nine rejections to find one yes. How to build a pipeline wide enough that no is cheap, and how to kill your own favorite idea in the first meeting rather than the ninth.' },
  { n: 'Principle five', t: 'Bet on the Jockey',
    d: 'Investors spend more time on the team than the plan, because the plan will change and the team will not. What that means for which internal projects you back and who you put on them.' },
  { n: 'Principle six', t: 'Agree to Disagree',
    d: 'Consensus is a warning sign. The best partnerships appoint someone to argue the other side, on purpose, every time. A decision everybody liked is usually the one nobody examined.' },
  { n: 'Principle seven', t: 'Double Down or Quit',
    d: 'The next check should be earned, not assumed. How to stop a project without ending a career, and how to spot the one that deserves three times what you planned to give it.' },
  { n: 'Principle eight', t: 'Make the Pie Bigger',
    d: 'Nobody takes a real risk on a fixed salary. What ownership does to behavior, and why the companies that create the most value are the ones that give the most of it away.' },
  { n: 'Principle nine', t: 'Great Things Take Time',
    d: 'The returns show up in year seven and your reporting cycle is ninety days. Holding a position long enough to be proven right. We close by going back around the room, decision by decision.' },
];

const faqs = [
  {
    q: 'How much time does it take?',
    a: 'Ten live sessions of ninety minutes each, fifteen hours in total. Every session is recorded if you miss one.',
  },
  {
    q: 'Is this only for people in venture capital?',
    a: 'No. It is for executives making decisions under uncertainty inside established companies. The principles come from how venture investors decide, and the whole point is applying them where the stakes and the constraints are different.',
  },
  {
    q: 'Do I need to have read the book?',
    a: 'No. The sessions stand on their own, and they are taught by one of the two people who wrote it. Reading it first will make the discussion sharper, and we send materials two weeks ahead either way.',
  },
  {
    q: 'What do I need to prepare?',
    a: 'Materials go out two weeks before the first session. Bring one decision you have not made yet and are willing to work on in front of a room of peers. That is the only prerequisite.',
  },
  {
    q: 'Can my company pay?',
    a: 'Yes. We invoice directly and provide a receipt for expensing, plus a one-page summary you can send to your manager. Team rates apply from three participants.',
  },
];
---

<Layout
  title="The Venture Mindset"
  description="Ten live sessions on making smarter bets under uncertainty, taught by Alex Dang, co-author of The Venture Mindset."
>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">The Venture Mindset</p>
      <h1 class="display h1">Make smarter bets under <span class="accent">uncertainty.</span></h1>
      <p class="lede" style="margin-top:24px;">
        Ten live sessions on the nine principles venture investors use to decide, taught by
        <strong>Alex Dang</strong>, co-author of <em>The Venture Mindset</em>, with
        <strong>Ilya Strebulaev</strong> of Stanford joining as a guest.
      </p>
      <div class="facts" style="margin-top:30px;">
        <span>Starts 16 November 2026</span>
        <span>10 sessions</span>
        <span>15 hours live</span>
        <span>30 seats</span>
        <span>$4,500</span>
      </div>
      <div class="btnrow" style="margin-top:30px;">
        <a href="/apply" class="btn btn--solid">Apply</a>
        <a href="#masterclass" class="btn btn--ghost">Try a free masterclass</a>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ============ WHY ============ -->
  <section>
    <div class="shell">
      <p class="eyebrow">Why this exists</p>
      <h2 class="display h3" style="margin-bottom:16px;">
        Most corporate decision-making is built for a world that no longer exists.
      </h2>
      <p class="body" style="margin-bottom:32px;">
        The methods that work in a predictable business fail when the future is genuinely
        unknown: consensus, a single detailed plan, one large committed bet, and a process
        that punishes anyone associated with a failure. Venture investors have spent decades
        deciding under exactly those conditions, and their approach inverts almost every one
        of those instincts.
      </p>
      <div class="rows" data-rise-group>
        <div class="row">
          <h3>You are placing bets whether you call them that or not</h3>
          <p>Every product, hire, acquisition and AI initiative is a bet under uncertainty.
          Most companies just make them one at a time, at full size, with no way to stop.</p>
        </div>
        <div class="row">
          <h3>The principles are counterintuitive on purpose</h3>
          <p>Reject most things quickly. Appoint someone to argue against you. Fund in
          stages. Kill your own projects. Each of these feels wrong inside a corporate
          process, and each is why venture returns look the way they do.</p>
        </div>
        <div class="row">
          <h3>Taught by the person who wrote it</h3>
          <p>Alex Dang co-authored the book with Stanford's Ilya Strebulaev, drawing on two
          decades of research and his own operating years at Amazon and McKinsey.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MASTERCLASS ============ -->
  <section id="masterclass" class="mc-band">
    <div class="shell">
      <div class="mc-inner" data-rise>
        <div>
          <p class="label" style="color:rgba(245,243,238,.5)">Free · no obligation</p>
          <h2 class="display h3" style="color:var(--bone); margin-top:10px;">Try it first.</h2>
          <p style="color:rgba(245,243,238,.78); max-width:48ch; margin:14px 0 0;">
            <strong>The Nine Principles VCs Use to Pick Winners</strong>, a thirty minute
            masterclass with Alex Dang on 21 September. The nine principles in outline,
            from the person who wrote them, and free.
          </p>
        </div>
        <a href="/masterclasses#signup" class="btn btn--solid">Save my seat</a>
      </div>
    </div>
  </section>

  <!-- ============ SESSIONS ============ -->
  <section>
    <div class="shell">
      <p class="eyebrow">The program</p>
      <h2 class="display h3" style="margin-bottom:16px;">
        Bring one real decision. Take it apart nine ways.
      </h2>
      <p class="body" style="margin-bottom:28px;">
        This is not nine lectures about other people's companies. You arrive with a
        decision you have not made yet, and every principle gets applied to it, in the
        room, with the people who wrote them. By the last session you have made it.
      </p>
      <div class="vm-sessions" data-rise-group>
        {sessions.map((s) => (
          <div class="vm-row">
            <span class="vm-num">{s.n}</span>
            <div>
              <h3 class="display vm-title">{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ============ FACULTY ============ -->
  <section>
    <div class="shell">
      <p class="eyebrow">Faculty</p>
      <div class="grid grid--3" style="margin-top:22px;" data-rise-group>
        <article class="card fac">
          <Portrait src="/faculty/alex-dang.jpg" name="Alex Dang" size="lg" />
          <p class="label">Program Lead</p>
          <h3 class="display h4">Alex Dang</h3>
          <p>Co-author of <em>The Venture Mindset: How to Make Smarter Bets and
          Achieve Extraordinary Growth</em>, a Financial Times Business Book of the
          Month, now translated into twelve languages. Senior Advisor and former
          Partner at McKinsey, previously a product executive at Amazon and AWS.
          He advises large companies on building venture-style decision-making
          inside established organizations.</p>
        </article>
        <article class="card fac">
          <Portrait src="/faculty/gregory-la-blanc.jpg" name="Gregory La Blanc" size="lg" />
          <p class="label">Faculty Director</p>
          <h3 class="display h4">Gregory La Blanc</h3>
          <p>Faculty at UC Berkeley, where he teaches finance, strategy and the
          economics of information across the business, law and engineering
          schools. He is the constant across every program we run.</p>
        </article>
        <article class="card fac">
          <Portrait src="/faculty/hannes-chopra.jpg" name="Hannes Chopra" size="lg" />
          <p class="label">Faculty</p>
          <h3 class="display h4">Hannes Chopra</h3>
          <p>CEO of RaSa Future Fund, which invests in early stage companies
          disrupting financial services and insurance, and of RaSa Consulting,
          a leadership development firm. Twenty years in leadership at Allianz
          Group, where he was CEO in Russia and regional head of Eurasia and sat
          on boards in eight countries. He built Sberbank Insurance from scratch
          for Russia's largest bank. Certified executive coach at PCC level.</p>
        </article>
      </div>

      <h3 class="display h4" style="margin:44px 0 16px;">Joining as a guest</h3>
      <div class="guest-grid" data-rise-group>
        <figure class="guest-card">
          <Portrait src="/faculty/ilya-strebulaev.jpg" name="Ilya Strebulaev" size="md" />
          <figcaption>
            <span class="gname">Ilya Strebulaev</span>
            <span class="gaff">Stanford GSB · co-author of The Venture Mindset</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ============ PRICE ============ -->
  <section>
    <div class="shell shell--narrow">
      <p class="eyebrow">Tuition</p>
      <h2 class="display h2">$4,500</h2>
      <p class="body" style="margin:16px 0 20px;">
        Includes all ten sessions, the recordings, and the materials.
      </p>
      <ul class="incl">
        <li>Team rate from three participants</li>
        <li>A decision you are actually facing, worked through across the program</li>
        <li>Invoice and receipt for expensing</li>
        <li>Recordings if you miss a session</li>
      </ul>
    </div>
  </section>

  <hr class="rule" />

  <!-- ============ FAQ ============ -->
  <section>
    <div class="shell shell--narrow">
      <p class="eyebrow">Questions</p>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CLOSING ============ -->
  <section class="closing">
    <div class="shell center">
      <h2 class="display h2" style="color:var(--bone)">Starts 16 November 2026.</h2>
      <p style="color:rgba(245,243,238,.78); margin:18px auto 28px; max-width:46ch;">
        Thirty seats. Apply and we will come back to you within a few days.
      </p>
      <div class="btnrow" style="justify-content:center;">
        <a href="/apply" class="btn btn--solid">Apply</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero { padding-top: clamp(48px, 7vw, 84px); }

  .vm-sessions { border-top: 1px solid var(--line-2); }
  .vm-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 8px 40px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .vm-num {
    font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em;
    text-transform: uppercase; color: var(--signal); font-weight: 600; padding-top: 5px;
  }
  .vm-title { font-size: 1.15rem; letter-spacing: -.018em; margin: 0 0 6px; }
  .vm-row p { margin: 0; color: var(--ink-2); font-size: .95rem; max-width: 62ch; }
  @media (max-width: 720px) {
    .vm-row { grid-template-columns: 1fr; gap: 4px; padding: 20px 0; }
  }

  .fac h3 { margin: 4px 0 10px; }
  .fac .label { margin: 14px 0 0; }
  .fac p:last-child { color: var(--ink-2); font-size: .92rem; margin: 0; }

  .incl { list-style: none; padding: 0; margin: 0; }
  .incl li { padding: 12px 0; border-top: 1px solid var(--line); color: var(--ink-2); font-size: .95rem; }

  .faq details { border-bottom: 1px solid var(--line); padding: 4px 0; }
  .faq summary { cursor: pointer; padding: 16px 0; font-weight: 650; font-size: 1rem; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::before { content: '+'; color: var(--signal); font-weight: 700; margin-right: 12px; }
  .faq details[open] summary::before { content: '−'; }
  .faq p { margin: 0 0 18px 26px; color: var(--ink-2); font-size: .95rem; max-width: 60ch; }

  .mc-band { background: var(--ink); }
  .mc-inner { display: flex; flex-wrap: wrap; align-items: center;
    justify-content: space-between; gap: 26px; }

  .closing { background: var(--ink); }
</style>
