---
import Layout from '../layouts/Layout.astro';
import MasterclassCard from '../components/MasterclassCard.astro';
import { masterclasses } from '../data/masterclasses.js';
import { FORM_ENDPOINT } from '../data/site.js';
---

<Layout title="Masterclasses" description="Free, live sessions with our faculty.">
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Masterclasses</p>
      <h1 class="display h2">Sit in before you apply.</h1>
      <p class="lede" style="margin-top:22px;">
        A masterclass is one real session lifted out of a program and opened to everyone.
        Same material, same faculty, same way we run the room.
      </p>
      <p class="body" style="margin-top:18px; max-width:60ch;">
        It answers the three things you cannot get from a page like this one: what the
        program actually covers, how the person teaching it thinks, and whether the way we
        work suits you. You put your own question to them and they answer it.
      </p>
      <p class="body" style="margin-top:14px; max-width:60ch;">
        Nobody will pitch you. If the program is right for you that will be obvious by the
        end, and if it is not, you have saved yourself a decision.
      </p>
    </div>
  </section>

  <hr class="rule" />

  <section>
    <div class="shell">
      <p class="eyebrow">Upcoming</p>
      <div class="mc-list">
          {masterclasses.map((mc) => <MasterclassCard mc={mc} />)}
      </div>
    </div>
  </section>

  <!-- Rendered open, then closed by the script below. Without JS it stays a
       normal inline form rather than an inert hidden one. -->
  <dialog id="signup" class="mcdialog" open>
    <form method="dialog" class="mcdialog-x"><button aria-label="Close">&times;</button></form>
    <p class="label">Save your seat</p>
    <h2 class="display h4" style="margin:8px 0 16px;">Which session?</h2>

    <form method="POST" action={FORM_ENDPOINT}>
      <input type="hidden" name="_subject" value="Masterclass signup" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" value="https://siliconvalleyfaculty.com/thanks" />
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
      <div class="field">
        <label for="mc-which">Masterclass</label>
        <select id="mc-which" name="masterclass" required>
          {masterclasses.map((mc) => (
            <option value={`${mc.title} (${mc.date ?? mc.window ?? 'date to be set'})`}>
              {mc.title}
            </option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="mc-name">Name</label>
        <input id="mc-name" name="name" required />
      </div>
      <div class="field">
        <label for="mc-email">Work email</label>
        <input id="mc-email" type="email" name="email" placeholder="you@company.com" required />
      </div>
      <div class="field">
        <label for="mc-company">Company and role</label>
        <input id="mc-company" name="company" />
      </div>
      <button type="submit" class="btn btn--solid" style="width:100%;">Save my seat</button>
      <p class="dim tiny">
        We email you the joining link and nothing else. No spam, no list sharing.
      </p>
    </form>
  </dialog>

  <section class="closing">
    <div class="shell center">
      <h2 class="display h3" style="color:var(--bone)">The programs these come from</h2>
      <div class="btnrow" style="justify-content:center; margin-top:24px;">
        <a href="/programs" class="btn btn--solid">See the programs</a>
      </div>
    </div>
  </section>
  <script is:inline>
    // The form ships open so it works without JS. With JS it becomes a dialog
    // that each card opens with its own session already chosen.
    (function () {
      var dlg = document.getElementById('signup');
      var sel = document.getElementById('mc-which');
      if (!dlg || !sel || !dlg.showModal) return;
      dlg.close();

      document.querySelectorAll('.mc-list .mc-cta').forEach(function (a, i) {
        a.addEventListener('click', function (e) {
          e.preventDefault();
          sel.selectedIndex = i;
          dlg.showModal();
          var first = dlg.querySelector('#mc-name');
          if (first) first.focus();
        });
      });

      // click the backdrop to dismiss
      dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });

      // other pages link straight to /masterclasses#signup, so honour the hash
      function openFromHash() {
        if (location.hash === '#signup' && !dlg.open) dlg.showModal();
      }
      openFromHash();
      window.addEventListener('hashchange', openFromHash);
    })();
  </script>
</Layout>

<style>
  .hero { padding-top: clamp(48px, 7vw, 84px); }


  .mc-list { display: grid; gap: 20px; }

  .mcdialog {
    max-width: 460px; width: calc(100% - 32px);
    border: 1px solid var(--line); border-radius: 5px;
    background: var(--surface); color: var(--ink);
    padding: 30px; position: relative;
  }
  .mcdialog::backdrop { background: rgba(17,18,20,.55); }
  .mcdialog-x { position: absolute; top: 10px; right: 12px; margin: 0; }
  .mcdialog-x button {
    background: none; border: 0; cursor: pointer; font-size: 1.5rem;
    line-height: 1; color: var(--mid); padding: 4px 8px;
  }
  .mcdialog-x button:hover { color: var(--ink); }
  /* Without JS it sits inline in the page, so it needs its own spacing.
     As a modal the browser centres it with margin:auto, which that rule
     would otherwise cancel, pinning the dialog to the top of the screen. */
  .mcdialog[open] { margin: 0 auto 60px; }
  .mcdialog:modal { margin: auto; max-height: calc(100vh - 48px); overflow-y: auto; }


  .tiny { font-size: .74rem; margin: 12px 0 0; line-height: 1.5; }
  .closing { background: var(--ink); }
</style>
