---
/**
 * Shown in place of a form while FORM_ACCESS_KEY is unset.
 *
 * Without this a form posts an invalid key, the submission is lost, and the
 * person believes they contacted us. A mailto is slower but it arrives.
 */
import { SITE } from '../data/site.js';
const { subject = 'Enquiry', what = 'your name, company and role' } = Astro.props;
---

<div class="offline">
  <p class="label" style="color:var(--signal)">By email for now</p>
  <h3 class="display h4" style="margin:10px 0 12px;">This form is not connected yet.</h3>
  <p class="offline-p">
    Rather than take your details and lose them, write to us directly with {what}.
    We reply to everything.
  </p>
  <p style="margin:18px 0 0;">
    <a href={`mailto:${SITE.email}?subject=${encodeURIComponent(subject)}`} class="btn btn--solid">
      Email us
    </a>
  </p>
</div>

<style>
  .offline {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--signal);
    border-radius: 4px;
    padding: 30px;
  }
  .offline-p { color: var(--ink-2); font-size: .95rem; max-width: 56ch; margin: 0; }
</style>
